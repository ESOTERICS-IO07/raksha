# ============================================================

# RAKSHA — Environment Variables

# ============================================================

#

# COPY THIS FILE TO .env FOR LOCAL DEVELOPMENT.

#

# NEVER COMMIT .env.

# NEVER PUT REAL BANKING CREDENTIALS IN THIS PROJECT.

# ============================================================

# -------------------------

# Application

# -------------------------

APP_ENV=development

API_HOST=0.0.0.0

API_PORT=8000

# -------------------------

# Database

# -------------------------

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/raksha

# -------------------------

# Redis

# -------------------------

REDIS_URL=redis://localhost:6379/0

# -------------------------

# Frontend → Backend

# -------------------------

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# -------------------------

# Intent Engine

# -------------------------

LLM_PROVIDER=mock

LLM_API_KEY=

LLM_MODEL=

# -------------------------

# Demo Configuration

# -------------------------

DEMO_MODE=true

USE_SYNTHETIC_DATA=true

# -------------------------

# Risk Configuration

# -------------------------

BEHAVIOR_WEIGHT=0.35

RECIPIENT_WEIGHT=0.25

INTENT_WEIGHT=0.40

LOW_RISK_MAX=30

MEDIUM_RISK_MAX=60

HIGH_RISK_MAX=80

# -------------------------

# Application Security

# -------------------------

SECRET_KEY=development-only-change-me
